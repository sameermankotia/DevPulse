# Copy to .env and fill in. Never commit the filled copy.
# Prefer scripts/dev.sh, which reads secrets from 1Password at launch instead.

ENVIRONMENT=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Optional: lets preview deployments through without listing each hostname,
# e.g. https://.*\.vercel\.app
CORS_ORIGIN_REGEX=

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=devpulse
POSTGRES_PASSWORD=devpulse
POSTGRES_DB=devpulse

# Seeds a realistic dataset so the UI works without GitHub credentials.
DEMO_MODE=true

# A classic or fine-grained token with repo + actions:read. Optional:
# without it the API serves demo data only.
GITHUB_TOKEN=

# Recommendations. Without a key the dashboard renders and the Analyze
# button explains that the key is missing.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-4.8
